<!--
    App.axaml : décrit l'APPLICATION dans son ensemble (pas une fenêtre).
    On y choisit surtout le thème visuel, c'est-à-dire l'apparence par
    défaut des boutons, textes, etc. pour toute l'application.

    Ce fichier va avec App.axaml.cs (le code C# associé).
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bonjour.App"
             RequestedThemeVariant="Default">
    <!--
        Les deux lignes "xmlns" sont toujours les mêmes : elles disent
        que ce fichier utilise les balises d'Avalonia. On les recopie.

        x:Class : relie ce fichier à la classe C# "App" (App.axaml.cs).

        RequestedThemeVariant : "Light" (clair), "Dark" (sombre),
        ou "Default" (suit le réglage de l'ordinateur).
    -->

    <Application.Styles>
        <!-- FluentTheme : le thème visuel moderne fourni par Avalonia. -->
        <FluentTheme />
    </Application.Styles>
</Application>
